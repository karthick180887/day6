# Copy this file to .env if you want to customize ports or settings:
#   cp .env.example .env

# Port on your laptop where JupyterLab will be reachable (http://localhost:8888)
JUPYTER_PORT=8888

# Access token for JupyterLab login (set to empty string to disable token on trusted localhost)
JUPYTER_TOKEN=day6-training

# Global reproducibility seed used across Day 6 notebooks
RANDOM_SEED=42

# Logging verbosity (INFO or DEBUG)
LOG_LEVEL=INFO

# Environment label recorded in experiment logs
TRAINING_ENV=classroom-local
